# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ----- PostgreSQL container (used by docker-compose to initialize the DB) -----
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=marketpulse

# ----- Application connection (used by the Python app and Dagster) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketpulse
DB_USER=marketpulse
DB_PASSWORD=change_me_locally

# ----- Full connection string (used by Alembic migrations) -----
DATABASE_URL=postgresql+psycopg://marketpulse:change_me_locally@localhost:5432/marketpulse